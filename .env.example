# ─────────────────────────────────────────────
# DATABASE (Supabase PostgreSQL)
# ─────────────────────────────────────────────
# Get from: Supabase Dashboard → Settings → Database → Connection string
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ─────────────────────────────────────────────
# SUPABASE (Auth + Client)
# ─────────────────────────────────────────────
# Get from: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ─────────────────────────────────────────────
# EXTERNAL APIs (server-side only — never expose to client)
# ─────────────────────────────────────────────

# Polygon.io — US stocks, dividends, splits
# Get from: https://polygon.io/dashboard
POLYGON_API_KEY=""

# TASE DataWise — Israeli securities
# Get from: TASE DataWise portal
TASE_API_KEY=""
TASE_API_URL="https://api.tase.co.il/api"

# Anthropic — AI agents (Claude)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# FreeCurrencyAPI — USD/ILS exchange rates (free tier: 1500 req/month)
# Get from: https://freecurrencyapi.com/
FREECURRENCY_API_KEY=""

# ─────────────────────────────────────────────
# APP
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
