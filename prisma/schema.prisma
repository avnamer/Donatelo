generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Portfolio {
  id            String         @id @default(uuid())
  userId        String         @map("user_id")
  name          String
  baseCurrency          String         @default("ILS") @map("base_currency")
  globalDipThreshold    Float          @default(0.10) @map("global_dip_threshold")
  globalBuyNowThreshold Float          @default(0.20) @map("global_buy_now_threshold")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")
  agentInsights         AgentInsight[]
  cashAccounts  CashAccount[]
  folders       Folder[]
  transactions  Transaction[]
  dipAlerts     DipAlert[]

  @@index([userId])
  @@map("portfolios")
}

model Folder {
  id                  String    @id @default(uuid())
  portfolioId         String    @map("portfolio_id")
  parentId            String?   @map("parent_id")
  name                String
  color               String?
  targetAllocationPct Decimal?  @map("target_allocation_pct") @db.Decimal(5, 2)
  sortOrder           Int       @default(0) @map("sort_order")
  isHiddenWhenShared  Boolean   @default(false) @map("is_hidden_when_shared")
  isWatchlist         Boolean   @default(false) @map("is_watchlist")
  createdAt           DateTime  @default(now()) @map("created_at")
  parent              Folder?   @relation("FolderTree", fields: [parentId], references: [id])
  children            Folder[]  @relation("FolderTree")
  portfolio           Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  holdings            Holding[]
  watchlistSources    Holding[]  @relation("WatchlistTarget")

  @@index([portfolioId])
  @@index([parentId])
  @@map("folders")
}

model Holding {
  id                  String         @id @default(uuid())
  folderId            String         @map("folder_id")
  tickerSymbol        String         @map("ticker_symbol")
  exchange            String
  name                String
  expenseRatio        Decimal?       @map("expense_ratio") @db.Decimal(6, 4)
  targetAllocationPct Decimal?       @map("target_allocation_pct") @db.Decimal(5, 2)
  isActive            Boolean        @default(true) @map("is_active")
  targetFolderId      String?        @map("target_folder_id")
  plannedAmount       BigInt?        @map("planned_amount")
  dipThreshold        Float?         @map("dip_threshold")
  buyNowThreshold     Float?         @map("buy_now_threshold")
  createdAt           DateTime       @default(now()) @map("created_at")
  agentInsights       AgentInsight[]
  thesis              HoldingThesis?
  targetFolder        Folder?        @relation("WatchlistTarget", fields: [targetFolderId], references: [id])
  folder              Folder         @relation(fields: [folderId], references: [id], onDelete: Cascade)
  lots                Lot[]
  transactions        Transaction[]
  dipAlerts           DipAlert[]

  @@index([folderId])
  @@index([tickerSymbol])
  @@index([targetFolderId])
  @@map("holdings")
}

model Lot {
  id                String        @id @default(uuid())
  holdingId         String        @map("holding_id")
  purchaseDate      DateTime      @map("purchase_date") @db.Date
  shares            Decimal       @db.Decimal(18, 6)
  costPerShare      BigInt        @map("cost_per_share")
  costCurrency      String        @default("ILS") @map("cost_currency")
  accountType       String?       @map("account_type")
  soldShares        Decimal       @default(0) @map("sold_shares") @db.Decimal(18, 6)
  soldDate          DateTime?     @map("sold_date") @db.Date
  soldPricePerShare BigInt?       @map("sold_price_per_share")
  proceedsFromSale  BigInt?       @map("proceeds_from_sale")
  notes             String?
  createdAt         DateTime      @default(now()) @map("created_at")
  holding           Holding       @relation(fields: [holdingId], references: [id], onDelete: Cascade)
  transactions      Transaction[]

  @@index([holdingId])
  @@map("lots")
}

model CashAccount {
  id                  String        @id @default(uuid())
  portfolioId         String        @map("portfolio_id")
  name                String
  currency            String
  balance             BigInt        @default(0)
  targetAllocationPct Decimal?      @map("target_allocation_pct") @db.Decimal(5, 2)
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  portfolio           Portfolio     @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  transactions        Transaction[]

  @@index([portfolioId])
  @@map("cash_accounts")
}

model Transaction {
  id            String       @id @default(uuid())
  portfolioId   String       @map("portfolio_id")
  type          String
  date          DateTime     @db.Date
  holdingId     String?      @map("holding_id")
  lotId         String?      @map("lot_id")
  cashAccountId String?      @map("cash_account_id")
  shares        Decimal?     @db.Decimal(18, 6)
  pricePerShare BigInt?      @map("price_per_share")
  amount        BigInt
  currency      String
  realizedGain  BigInt?      @map("realized_gain")
  notes         String?
  createdAt     DateTime     @default(now()) @map("created_at")
  cashAccount   CashAccount? @relation(fields: [cashAccountId], references: [id])
  holding       Holding?     @relation(fields: [holdingId], references: [id])
  lot           Lot?         @relation(fields: [lotId], references: [id])
  portfolio     Portfolio    @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
  @@index([date(sort: Desc)])
  @@index([holdingId])
  @@map("transactions")
}

model PriceCache {
  id           String   @id @default(uuid())
  tickerSymbol String   @map("ticker_symbol")
  exchange     String
  price        BigInt
  currency     String
  priceDate    DateTime @map("price_date") @db.Date
  fetchedAt    DateTime @default(now()) @map("fetched_at")

  @@unique([tickerSymbol, priceDate])
  @@index([tickerSymbol, priceDate(sort: Desc)])
  @@map("price_cache")
}

model DividendCache {
  id             String    @id @default(uuid())
  tickerSymbol   String    @map("ticker_symbol")
  exchange       String
  declareDate    DateTime? @map("declare_date") @db.Date
  exDate         DateTime  @map("ex_date") @db.Date
  payDate        DateTime? @map("pay_date") @db.Date
  amountPerShare BigInt    @map("amount_per_share")
  currency       String
  frequency      String?
  fetchedAt      DateTime  @default(now()) @map("fetched_at")

  @@unique([tickerSymbol, exDate])
  @@index([tickerSymbol])
  @@map("dividend_cache")
}

model FxRate {
  id           String   @id @default(uuid())
  fromCurrency String   @map("from_currency")
  toCurrency   String   @map("to_currency")
  rate         Decimal  @db.Decimal(12, 6)
  rateDate     DateTime @map("rate_date") @db.Date
  fetchedAt    DateTime @default(now()) @map("fetched_at")

  @@unique([fromCurrency, toCurrency, rateDate])
  @@map("fx_rates")
}

model ExploreProfile {
  id          String   @id @default(uuid())
  name        String
  description String
  allocations Json
  isFeatured  Boolean  @default(false) @map("is_featured")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("explore_profiles")
}

model HoldingThesis {
  id          String   @id @default(uuid())
  holdingId   String   @unique @map("holding_id")
  userId      String   @map("user_id")
  rawText     String   @map("raw_text")
  thesis      String
  horizon     String?
  catalysts   Json     @default("[]")
  riskFactors Json     @default("[]") @map("risk_factors")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  holding     Holding  @relation(fields: [holdingId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("holding_theses")
}

model AgentInsight {
  id          String    @id @default(uuid())
  portfolioId String    @map("portfolio_id")
  userId      String    @map("user_id")
  type        String
  severity    String
  holdingId   String?   @map("holding_id")
  title       String
  body        String
  dismissed   Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")
  holding     Holding?  @relation(fields: [holdingId], references: [id], onUpdate: NoAction)
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([portfolioId, dismissed])
  @@index([createdAt(sort: Desc)])
  @@map("agent_insights")
}

model CsvImportRule {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  pattern         Json
  transactionType String   @map("transaction_type")
  ticker          String?
  exchange        String?
  cashAccountName String?  @map("cash_account_name")
  toCashAccountName String? @map("to_cash_account_name")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("csv_import_rules")
}

model DipAlert {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  portfolioId  String   @map("portfolio_id")
  holdingId    String   @map("holding_id")
  ticker       String
  name         String
  currentPrice Float    @map("current_price")
  high52w      Float    @map("high_52w")
  highATH      Float?   @map("high_ath")
  high90d      Float    @map("high_90d")
  dropFrom52w  Float    @map("drop_from_52w")
  dropFromATH  Float?   @map("drop_from_ath")
  dropFrom90d  Float    @map("drop_from_90d")
  priceHistory Json     @map("price_history")
  aiSuggestion    String?  @map("ai_suggestion")
  dipTriggered    Boolean  @default(true) @map("dip_triggered")
  buyNowTriggered Boolean  @default(false) @map("buy_now_triggered")
  computedAt      DateTime @map("computed_at")

  holding   Holding   @relation(fields: [holdingId], references: [id], onDelete: Cascade)
  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([holdingId, portfolioId])
  @@index([portfolioId, computedAt(sort: Desc)])
  @@map("dip_alerts")
}
